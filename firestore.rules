
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper function to determine if a user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Helper function to determine if the request is made by the owner of the document.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Helper function to determine if the user has an admin role.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * Helper function to check if the user's account is active and not expired.
     */
    function isAccountActive() {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        if (userDoc.status == 'Expired') {
          return false;
        }
        if (!('validityDate' in userDoc) || userDoc.validityDate == '') {
            return userDoc.status == 'Active'; // For users without a validity date, just check status
        }
        // Compare the validityDate string with the current time.
        let validityMillis = timestamp.date(
          int(userDoc.validityDate.split('-')[0]),
          int(userDoc.validityDate.split('-')[1]),
          int(userDoc.validityDate.split('-')[2])
        ).toMillis();
        return validityMillis >= request.time.toMillis() && userDoc.status == 'Active';
    }

    /**
     * Rules for user profiles and their nested data.
     */
    match /users/{userId} {
      // A user should always be able to read their own profile to check status. Admins can read any.
      allow get: if isOwner(userId) || isAdmin();
      // Only active users or admins can update/delete profiles.
      allow update, delete: if (isAdmin() || isOwner(userId)) && isAccountActive();
      // Only admins can list all users.
      allow list: if isAdmin();
      // Any signed-in user can create their own profile during signup.
      allow create: if isSignedIn();

      /**
       * Rules for nested animal records.
       */
      match /animals/{animalId} {
        // Owner or Admin can perform any action on a specific document, but only if their account is active.
        allow read, write: if (isOwner(userId) || isAdmin()) && isAccountActive();
      }
      
      /**
       * Rules for nested movement records.
       */
      match /movements/{movementId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isAccountActive();
      }
      
      /**
       * Rules for nested financial records.
       */
      match /financial_records/{financialRecordId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isAccountActive();
      }

      /**
       * Rules for nested milk records.
       */
      match /milk_records/{milkRecordId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isAccountActive();
      }
       
      /**
       * Rules for nested reports.
       */
       match /reports/{reportId} {
         allow read, write: if (isOwner(userId) || isAdmin()) && isAccountActive();
       }

      /**
       * Rules for nested account records.
       */
      match /accounts/{accountId} {
        allow read, write: if (isOwner(userId) || isAdmin()) && isAccountActive();
      }
      
      /**
       * Rules for user notifications.
       * Users should be able to read their notifications even if their account is expired.
       */
      match /notifications/{notificationId} {
        // Users can read, update (to mark as read), and delete their own notifications.
        allow read, update, delete: if isOwner(userId);
        // Admins can list and create notifications.
        allow list, create: if isAdmin() || isOwner(userId);
      }
    }

    /**
     * Rules for AMC renewal requests (top-level collection).
     */
    match /amc_renewals/{renewalId} {
      // Users can create their own renewal requests, even if their account is expired.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Admins can read, list, update, or delete renewal requests.
      allow get, list, update, delete: if isAdmin();
    }

    /**
     * Rules for admin roles collection.
     */
    match /roles_admin/{userId} {
      // Only admins can read, create, or update roles.
      allow get, write: if isAdmin();
      // Nobody can list all admin roles for security.
      allow list, delete: if false;
    }
  }
}
