/**
 * @fileoverview Firestore Security Rules for the GauRakshak application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (users and their associated AMC details),
 * and a public-read with owner-write model for animal records and financial transactions. Administrative privileges
 * are managed through a dedicated collection, `roles_admin`.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores personal user data. Only the user themselves can read or write their own document.
 * - `/animals/{animalId}`: Stores animal records. These are publicly readable, but only the creating user can modify or delete them.
 *   Each animal document MUST contain a denormalized `ownerId` field that matches the user who created it.
 * - `/animals/{animalId}/movements/{animalMovementId}`: Stores movement history for each animal. Inherits access control from the parent animal document.
 *   The existence of the parent document must be validated before allowing operations on the movement records.
 * - `/financial_records/{financialRecordId}`: Stores financial records. Publicly readable, but write access is restricted to the creating user.
 *   Each financial record MUST contain a denormalized `ownerId` field indicating the creator.
 * - `/amc_renewals/{renewalId}`: Stores user-submitted AMC renewal requests. Readable by admins, writable by the user who owns it.
 * - `/roles_admin/{userId}`: Presence of a document in this collection grants the user admin privileges.
 *
 * Key Security Decisions:
 * - User listing is explicitly disallowed for non-admins.
 * - The default security posture is strict: if a relationship or permission is not explicitly granted, it is denied.
 * - Data validation is minimized to facilitate rapid prototyping. Only authorization-critical fields are validated.
 *
 * Denormalization for Authorization:
 * - `animals` and `financial_records` collections include an `ownerId` field to simplify write authorization and avoid `get()` calls.
 * - Admin status is determined by the presence of a document in the `roles_admin` collection, avoiding complex role lookups.
 *
 * Structural Segregation:
 * - Private user data is stored under the `/users/{userId}` path, while public animal and financial data reside in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper function to determine if a user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Helper function to determine if the request is made by the owner of the document.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Helper function to determine if the user has an admin role.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Helper function to check if the user's account is active and not expired.
     */
    function isAccountActive() {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        if (!('validityDate' in userDoc) || userDoc.validityDate == '') {
            return userDoc.status == 'Active'; // For users without a validity date, just check status
        }
        // Compare the validityDate string with the current time.
        let validityMillis = timestamp.date(
          int(userDoc.validityDate.split('-')[0]),
          int(userDoc.validityDate.split('-')[1]),
          int(userDoc.validityDate.split('-')[2])
        ).toMillis();
        return validityMillis >= request.time.toMillis() && userDoc.status == 'Active';
    }


    /**
     * Rules for user profiles.
     */
    match /users/{userId} {
      // Admins can read any user profile, users can read their own.
      allow get: if isAdmin() || isOwner(userId);
      // Only admins can list all users.
      allow list: if isAdmin();
      // Any signed-in user can create their own profile.
      allow create: if isOwner(userId);
      // Admins can update any profile, users can update their own.
      // Customer ID and Role can only be set by an Admin.
      allow update: if isAdmin() || (isOwner(userId) && !(request.resource.data.customerId != resource.data.customerId) && !(request.resource.data.role != resource.data.role));
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    /**
     * Rules for animal records and their movement subcollection.
     */
    match /animals/{animalId} {
      allow read: if isSignedIn();
      // Only active, non-expired users or admins can write to animal records.
      allow write: if isAccountActive() || isAdmin();

        match /movements/{movementId} {
            allow read: if isSignedIn();
            // Only active, non-expired users or admins can write to movement records.
            allow write: if isAccountActive() || isAdmin();
        }
    }

    /**
     * Rules for financial records.
     */
    match /financial_records/{financialRecordId} {
      allow read: if isSignedIn();
      // Only active, non-expired users or admins can write to financial records.
      allow write: if isAccountActive() || isAdmin();
    }

    /**
     * Rules for AMC renewal requests.
     */
    match /amc_renewals/{renewalId} {
      // Users can create their own renewal requests.
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      // Admins can read, list, update, or delete renewal requests.
      allow list, read, update, delete: if isAdmin();
    }

    /**
     * Rules for admin roles collection. Read-only for most, writable only by admins.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list, delete: if false; // Nobody can list or delete roles directly.
      // Only an admin can create or update a role document.
      allow write: if isAdmin();
    }
  }
}
