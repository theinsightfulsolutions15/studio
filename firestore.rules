/**
 * @fileoverview Firestore Security Rules for the GauRakshak application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (users and their associated AMC details),
 * and a public-read with owner-write model for animal records and financial transactions. Administrative privileges
 * are managed through a dedicated collection, `roles_admin`.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores personal user data. Only the user themselves can read or write their own document.
 * - `/users/{userId}/amc_details/{amcDetailId}`: Stores AMC details specific to a user. Only the user can manage these details.
 * - `/animals/{animalId}`: Stores animal records. These are publicly readable, but only the creating user can modify or delete them.
 *   Each animal document MUST contain a denormalized `ownerId` field that matches the user who created it.
 * - `/animals/{animalId}/movements/{animalMovementId}`: Stores movement history for each animal. Inherits access control from the parent animal document.
 *   The existence of the parent document must be validated before allowing operations on the movement records.
 * - `/financial_records/{financialRecordId}`: Stores financial records. Publicly readable, but write access is restricted to the creating user.
 *   Each financial record MUST contain a denormalized `ownerId` field indicating the creator.
 * - `/roles_admin/{userId}`: Presence of a document in this collection grants the user admin privileges.
 *
 * Key Security Decisions:
 * - User listing is explicitly disallowed for non-admins.
 * - The default security posture is strict: if a relationship or permission is not explicitly granted, it is denied.
 * - Data validation is minimized to facilitate rapid prototyping. Only authorization-critical fields are validated.
 *
 * Denormalization for Authorization:
 * - `animals` and `financial_records` collections include an `ownerId` field to simplify write authorization and avoid `get()` calls.
 * - Admin status is determined by the presence of a document in the `roles_admin` collection, avoiding complex role lookups.
 *
 * Structural Segregation:
 * - Private user data is stored under the `/users/{userId}` path, while public animal and financial data reside in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profile documents based on path-based ownership.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *        request.auth.uid == 'user123' && request.resource.data.id == 'user123'
     * @allow (get) User with ID 'user123' can read their own profile.
     *        request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' can update their own profile.
     *        request.auth.uid == 'user123' && resource.data.id == 'user123'
     * @allow (delete) User with ID 'user123' can delete their own profile.
     *        request.auth.uid == 'user123' && resource.data.id == 'user123'
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     *       request.auth.uid == 'user456' && request.resource.data.id == 'user123'
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Grants access to AMC details based on path-based ownership.
     * @path /users/{userId}/amc_details/{amcDetailId}
     * @allow (create) User with ID 'user123' can create AMC details under their profile.
     *        request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' can read AMC details under their profile.
     *        request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' can update AMC details under their profile.
     *        request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' can delete AMC details under their profile.
     *        request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' cannot create AMC details under 'user123'.
     *       request.auth.uid == 'user456'
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/amc_details/{amcDetailId} {
      allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Grants public read access to animal records but restricts write access to the owner if not expired.
     * @path /animals/{animalId}
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /animals/{animalId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && (isOwner(request.resource.data.ownerId) || isAdmin()) && !isExpired();
    }

    /**
     * @description Grants access to animal movement records, inheriting ownership from the parent animal document.
     * @path /animals/{animalId}/movements/{animalMovementId}
     * @principle Inherits ownership from the parent document.
     */
    match /animals/{animalId}/movements/{animalMovementId} {
      allow read: if isSignedIn() && (get(/databases/$(database)/documents/animals/$(animalId)).data.ownerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (get(/databases/$(database)/documents/animals/$(animalId)).data.ownerId == request.auth.uid || isAdmin()) && !isExpired();
    }

    /**
     * @description Grants public read access to financial records but restricts write access to the owner if not expired.
     * @path /financial_records/{financialRecordId}
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /financial_records/{financialRecordId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && (isOwner(request.resource.data.ownerId) || isAdmin()) && !isExpired();
    }

    /**
     * @description Grants admin privileges based on the existence of a document in this collection.
     * @path /roles_admin/{userId}
     * @principle Role-based access control using a dedicated collection.
     */
    match /roles_admin/{userId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    /**
     * @description Helper function to determine if a user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Helper function to determine if the request is made by the owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the request is made by the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Helper function to determine if the request is made by the owner of an existing document.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the request is made by the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
    
    /**
     * @description Helper function to determine if the user has an admin role.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Helper function to check if the user's account is expired.
     * @return {boolean} True if the user's account is expired, false otherwise.
     */
    function isExpired() {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        // If there's no validity date, they are not expired.
        if (!('validityDate' in userDoc)) {
            return false;
        }
        // Compare the validityDate string with the current time.
        return userDoc.validityDate < request.time.toMillis().toString();
    }
  }
}
